{
  "name": "dsh-office-cli",
  "version": "0.1.0",
  "description": "为 AI agent 设计的 Office 套件：单二进制无 Office 安装控制 Word/Excel/PowerPoint，HTML 渲染引擎给 AI 眼睛（render→look→fix 闭环）、live preview 实时反馈、路径选择器精确定位元素、outline/HTML/JSON 多视图。受 iOfficeAI/OfficeCLI（28.8k★ Apache-2.0）启发。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "office",
    "word",
    "excel",
    "powerpoint",
    "office自动化"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/satan9394/dsh-public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
