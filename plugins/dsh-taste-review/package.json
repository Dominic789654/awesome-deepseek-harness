    "index.js",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "taste",
    "review",
    "design",
    "judgment",
    "审美判断"
  ],
  "license": "MIT",
