{
  "name": "dsh-autonomous-research",
  "version": "0.1.0",
  "description": "自主研究 agent：给 AI agent 一个小而真实的 LLM 训练设置，让它过夜自主实验——改代码→固定 5 分钟训练→检查 val_bpb 是否改善→保留或丢弃→重复（约 12 实验/小时、一晚约 100 个）；单文件修改、program.md 超轻量 skill。受 karpathy/autoresearch（94k★ MIT）启发。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "autonomous",
    "research",
    "llm-training",
    "karpathy",
    "自主研究"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/satan9394/dsh-public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
